{
  "name": "@franco_roura/module-01",
  "version": "1.0.0",
  "description": "Module/01: React components for a design system of glossy white parts, signal orange trim and HUD markings.",
  "keywords": [
    "components",
    "design-system",
    "module-01",
    "radix-ui",
    "react",
    "tailwindcss"
  ],
  "homepage": "https://franco-roura.github.io/module-01/",
  "bugs": "https://github.com/franco-roura/module-01/issues",
  "license": "(MIT OR Apache-2.0)",
  "author": "Franco Roura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franco-roura/module-01.git",
    "directory": "packages/module-01"
  },
  "files": [
    "dist",
    "tokens",
    "guidelines",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./finance": {
      "types": "./dist/finance.d.ts",
      "default": "./dist/finance.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "default": "./dist/charts.js"
    },
    "./site": {
      "types": "./dist/site.d.ts",
      "default": "./dist/site.js"
    },
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "build": "node scripts/build-tokens.ts && vp pack && node scripts/build-css.ts",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "lint:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints theme.css styles.css tokens.css"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.65.0",
    "radix-ui": "1.8.1",
    "react-day-picker": "10.0.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@size-limit/preset-small-lib": "14.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  }
}
